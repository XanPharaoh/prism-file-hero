{
  "name": "prism-file-hero",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "vendor:ocr": "node scripts/vendor-ocr-assets.mjs",
    "vendor:ocr:update": "node scripts/vendor-ocr-assets.mjs --update",
    "check:backend": "node scripts/backend-integration-check.mjs",
    "check:conversions": "vitest run tests/libreofficeConversion.test.ts tests/libreofficeProvider.test.ts",
    "browser:evidence": "node scripts/browser-evidence.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:internal-desktop": "VITE_DISTRIBUTION=internal-desktop vite build --outDir dist-desktop",
    "dev:internal-desktop": "VITE_DISTRIBUTION=internal-desktop vite",
    "tauri:build:internal:linux": "VITE_DISTRIBUTION=internal-desktop tauri build --bundles appimage,rpm",
    "tauri:build:internal:windows": "VITE_DISTRIBUTION=internal-desktop tauri build --bundles msi,nsis",
    "pipeline": "node pipeline/run.mjs",
    "pipeline:list-clients": "node pipeline/run.mjs --list-clients",
    "pipeline:list-rules": "node pipeline/run.mjs --list-rules",
    "pipeline:add-rule": "node pipeline/run.mjs --add-rule",
    "pipeline:dry-run": "node pipeline/run.mjs --dry-run",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run build && npx cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor-mlkit/document-scanner": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@clerk/react": "^6.12.8",
    "@google/genai": "^1.40.0",
    "@pdfsmaller/pdf-encrypt-lite": "^1.0.1",
    "@playwright/test": "^1.58.2",
    "@supabase/supabase-js": "^2.98.0",
    "@tauri-apps/api": "^2.10.1",
    "@types/react-router-dom": "^5.3.3",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "p-limit": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379",
    "playwright": "^1.62.1",
    "posthog-js": "^1.395.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "better-sqlite3": "^13.0.3",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.69.0",
    "xlsx": "^0.18.5"
  }
}
