# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit actual values.

# Worker URL for local dev (run `cd worker && npm run dev` first)
VITE_WORKER_URL=http://localhost:8787

# PostHog Analytics
VITE_POSTHOG_KEY=phc_your_project_api_key
VITE_POSTHOG_HOST=https://app.posthog.com

# --- Billing (PayPal Subscriptions) — SERVER-SIDE ONLY, never the browser ---
# The browser does NOT get any of these. Put them in worker/.dev.vars (local) or as wrangler
# secrets (deploy). The Client Secret + webhook verification happen server-side. Entitlement comes
# only from a VERIFIED payment covering the current period (PAYMENT.SALE.COMPLETED with a
# paid-through date) on a server-linked, allowlisted plan id — an ACTIVE subscription status alone,
# or a browser arriving with ?checkout=success, grants nothing.
#   worker/.dev.vars:
#     PAYPAL_CLIENT_ID=...            # sandbox app from developer.paypal.com
#     PAYPAL_SECRET=...               # server-side only
#     PAYPAL_ENV=sandbox              # sandbox | live  (no live payments until you flip it)
#     PAYPAL_WEBHOOK_ID=...           # id of the registered webhook (verify-webhook-signature)
#     PAYPAL_PLAN_PRO_MONTHLY=P-...   # allowlisted plan ids (also insert into billing_price_plans)
#     PAYPAL_PLAN_PRO_ANNUAL=P-...
#     PAYPAL_PLAN_BUSINESS_MONTHLY=P-...
#     PAYPAL_PLAN_BUSINESS_ANNUAL=P-...
#     FRONTEND_URL=https://your.app   # REQUIRED for /api/billing/paypal/subscribe. Where PayPal
#                                     # sends the buyer back (/app?checkout=…). Never derived from
#                                     # the Worker's own origin — that serves /api/* only and would
#                                     # answer the return navigation with a JSON 404. Without it the
#                                     # subscribe route returns 503 configured:false.
#     ALLOWED_ORIGINS=http://127.0.0.1:5173   # comma-separated browser origins the Worker accepts
