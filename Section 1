import type { ToolID, ToolCategory } from '../types';

export interface ToolExecutionPayload {
  files: File[];
  options: Record<string, any>;
  signal?: AbortSignal;
  onProgress?: (percent: number) => void;
}

export interface ToolResult {
  blob?: Blob;
  filename?: string;
  data?: any;
  metadata?: Record<string, any>;
}

export interface ToolHandler {
  id: ToolID;
  category: ToolCategory;
  name: string;
  description: string;
  icon: string;
  color: string;
  requiresAuth: boolean;
  requiresApiKey: boolean;
  allowedFileTypes: string[];
  maxFiles: number; // 0 = unlimited
  supportsBatchProcessing: boolean;
  handler: (payload: ToolExecutionPayload) => Promise<ToolResult>;
}

export const TOOL_REGISTRY: ToolHandler[] = [
  {
    id: 'merge',
    category: 'Organize',
    name: 'Merge PDF',
    description: 'Combine multiple PDFs into one document.',
    icon: 'Merge',
    color: 'bg-blue-500',
    requiresAuth: false,
    requiresApiKey: false,
    allowedFileTypes: ['application/pdf'],
    maxFiles: 0,
    supportsBatchProcessing: true,
    handler: async ({ files, options, signal }) => {
      const { mergePdfs } = await import('../services/pdfService');
      const blob = await mergePdfs(files, options?.mergePages);
      return { blob, filename: `Merged_${Date.now()}.pdf` };
    },
  },
  // ... implement ALL 15 tools: merge, split, compress, pdf-to-word, pdf-to-excel,
  // pdf-to-jpg, jpg-to-pdf, protect, redact, watermark, ocr, compare, rotate,
  // ocr-to-pdf, ocr-to-md, grammar-check
