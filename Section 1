import { readFile, writeFile } from '@tauri-apps/plugin-fs';

export class TauriFileSystemProvider implements FileSystemProvider {
  async pickFiles(toolId: ToolID, allowedTypes: string[], maxFiles: number): Promise<File[]> {
    const extensions = allowedTypes.map(t => t.split('/')[1]);
    const selected = await open({
      multiple: maxFiles === 0 || maxFiles > 1,
      filters: [{ name: 'Files', extensions }],
    });
    if (!selected) return [];
    const paths = Array.isArray(selected) ? selected : [selected];
