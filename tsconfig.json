{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["App.tsx", "index.tsx", "src/**/*", "services/**/*.ts", "shared/**/*.ts", "processing/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-desktop",
    "**/target/**",
    "**/*.js",
    "Prism File Hero Desktop"
  ]
}
